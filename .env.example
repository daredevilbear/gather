# Copy to .env, chmod 600, and fill in local secrets. Never commit .env.
GATHER_VERSION=1.0.0
HOMEPAGE_EXTERNAL_URL=https://gather.example.com
HOMEPAGE_ALLOWED_HOSTS=gather.example.com
HOMEPAGE_AUTH_SECRET=
HOMEPAGE_AUTH_PASSWORD=
GATHER_ADMIN_IDS=homepage
# Set all three for distinct OIDC identities; clear the shared password and
# replace GATHER_ADMIN_IDS with the administrator's stable provider subject.
HOMEPAGE_OIDC_ISSUER=
HOMEPAGE_OIDC_CLIENT_ID=
HOMEPAGE_OIDC_CLIENT_SECRET=
