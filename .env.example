# Copy to .env, chmod 600, and fill in local secrets. Never commit .env.
# Private review of the naming cleanup uses dev; pin the new release when available.
GATHER_VERSION=dev
GATHER_EXTERNAL_URL=https://gather.example.com
GATHER_ALLOWED_HOSTS=gather.example.com
GATHER_AUTH_SECRET=
GATHER_AUTH_PASSWORD=
GATHER_ADMIN_IDS=gather
# Existing shared-password installations can preserve their account subject.
GATHER_PASSWORD_USER_ID=gather
# Set all three for distinct OIDC identities; clear the shared password and
# replace GATHER_ADMIN_IDS with the administrator's stable provider subject.
GATHER_OIDC_ISSUER=
GATHER_OIDC_CLIENT_ID=
GATHER_OIDC_CLIENT_SECRET=

# Register /api/auth/callback/gather-oidc when using an image containing this option.
# The Gather callback is also the default when this option is unset.
GATHER_OIDC_PROVIDER_ID=gather-oidc
